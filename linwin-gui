    def toast(self, text, button=None, action=None):
        t = Adw.Toast(title=text, timeout=6)
        if button:
            t.set_button_label(button)
            t.connect("button-clicked", lambda *_: action())
        self.toasts.add_toast(t)

    def set_progress(self, percent, label):
        if not self.progress_group.get_visible():
            self.progress_group.set_visible(True)
            self.progress_start = time.monotonic()
        self.progress_label.set_label(label)
        self.progress_bar.set_fraction(percent / 100)
        self.progress_bar.set_text(f"{percent} %")
        # estimation : les plages de la CLI sont pondérées par la durée de chaque phase
        elapsed = time.monotonic() - self.progress_start
        if 3 <= percent < 100 and elapsed > 30:
            left = elapsed * (100 - percent) / percent
            self.progress_eta.set_label(f"Encore environ {max(1, round(left / 60))} min")
        else:
            self.progress_eta.set_label("")

    def end_progress(self, ok):
        if not self.progress_group.get_visible():
            return
        if ok:
            self.progress_bar.set_fraction(1)
            self.progress_bar.set_text("100 %")
            self.progress_eta.set_label("Terminé")
        else:
            self.progress_eta.set_label("Interrompu : voir le journal")
        run_id = self.progress_run

        def hide():
            if self.progress_run == run_id and not self.busy:
                self.progress_group.set_visible(False)
            return False

        GLib.timeout_add_seconds(8 if ok else 30, hide)

    def handle_output(self, raw, output):
        # les barres de progression réécrivent la ligne avec \r : on garde la dernière
        line = bytes(raw).decode("utf-8", "replace").split("\r")[-1]
        m = PROGRESS_RE.match(line)
        if m:
            self.set_progress(int(m.group(1)), m.group(2))
        elif not line.startswith("@@"):
            output.append(line)
            self.log(line + "\n")

    def follow_running(self):
        if self.busy or self.following:
            return
        """Une opération tourne sans nous (fenêtre fermée puis rouverte) : on relit
        son journal depuis le début, puis on le suit jusqu'à la fin de l'opération."""
        self.following = True
        self.set_busy(True)
        self.progress_run += 1
        self.log("\n--- Opération en cours, lancée avant l'ouverture de cette fenêtre ---\n")
        state = {"offset": 0, "pending": bytearray(), "output": []}

        def poll():
            alive = op_running()
            try:
                with open(RUN_LOG, "rb") as f:
                    f.seek(state["offset"])
                    data = f.read()
            except OSError:
                data = b""
            state["offset"] += len(data)
            buf = state["pending"]
            buf.extend(data)
            while (i := buf.find(b"\n")) >= 0:
                self.handle_output(buf[:i], state["output"])
                del buf[:i + 1]
            if alive:
                return True
            # fin : le code de sortie n'est pas connu, le journal dit si ça a échoué
            failed = any(l.startswith("ERREUR") for l in state["output"][-20:])
            self.log("--- Opération terminée ---\n")
            self.following = False
            self.end_progress(not failed)
            GLib.idle_add(lambda: self.set_busy(False) and False)
            return False

        if poll():
            GLib.timeout_add_seconds(1, poll)

    def set_busy(self, busy):
        self.busy = busy
        self.spinner.set_visible(busy)
        for b in self.iso_buttons + self.driver_buttons:
            b.set_sensitive(not busy)
        self.row_size.set_sensitive(not busy)
        self.row_auto.set_sensitive(not busy)
        if busy:
            self.cancel_button.set_sensitive(False)
            for s in self.all_steps:
                s.button.set_sensitive(False)
        else:
            self.refresh()

    def run(self, argv, root=False, stdin=None, on_done=None, bootstrap=False):
        """Lance la CLI en arrière-plan et recopie sa sortie dans le journal.

        root : via pkexec, uniquement sur la copie de confiance (sinon on propose
        de l'installer). bootstrap : la seule exception, « install » lui-même,
        après confirmation explicite de l'utilisateur.
        """
        if self.busy:
            return
        if root and not bootstrap and (not trusted(INSTALLED_CLI) or outdated()):
            self.ask_install(lambda: self.run(argv, root, stdin, on_done))
            return
        # sans root, la CLI de ce dossier suffit (et elle est à jour)
        exe = cli() if root and not bootstrap else LOCAL_CLI
        cmd = (["pkexec", exe] if root else [exe]) + ["--progress"] + argv
        self.log(f"\n$ {'pkexec ' if root else ''}linwin {' '.join(argv)}\n")
        flags = Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE
        if stdin is not None:
            flags |= Gio.SubprocessFlags.STDIN_PIPE
        try:
            proc = Gio.Subprocess.new(cmd, flags)
        except GLib.Error as e:
            self.log(f"Impossible de lancer la commande : {e.message}\n")
            return
        self.set_busy(True)
        self.progress_run += 1
        self.progress_group.set_visible(False)
        output = []
        if stdin is not None:
            pipe = proc.get_stdin_pipe()
            pipe.write_all(stdin.encode(), None)
            pipe.close(None)
        stdout = proc.get_stdout_pipe()
        pending = bytearray()

        def on_text(raw):
            self.handle_output(raw, output)

        def on_chunk(src, res):
            # lecture par blocs d'octets : un caractère non UTF-8 n'interrompt rien (sinon
            # le tube se fermerait et la CLI mourrait sur « Broken pipe »), et un bloc
            # vide signale sans ambiguïté la fin de la sortie
            try:
                data = src.read_bytes_finish(res).get_data()
            except GLib.Error:
                data = b""
            if not data:
                if pending:
                    on_text(pending)
                proc.wait_async(None, on_exit)
                return
            pending.extend(data)
            while (i := pending.find(b"\n")) >= 0:
                on_text(pending[:i])
                del pending[:i + 1]
            src.read_bytes_async(65536, GLib.PRIORITY_DEFAULT, None, on_chunk)

        def on_exit(p, res):
            p.wait_finish(res)
            code = p.get_exit_status() if p.get_if_exited() else -1
            if root and code in (126, 127):
                self.log("Authentification annulée ou refusée.\n")
            self.end_progress(code == 0)
            self.set_busy(False)
            if on_done:
                on_done(code, output)

        stdout.read_bytes_async(65536, GLib.PRIORITY_DEFAULT, None, on_chunk)

    def refresh(self):
        try:
            out = subprocess.run([LOCAL_CLI, "status"], capture_output=True, text=True, timeout=30).stdout
            self.status = json.loads(out)
        except (OSError, ValueError, subprocess.TimeoutExpired) as e:
            self.status = {"error": f"état illisible : {e}"}
        self.update_view()
        # même source que le suivi (op_running) : sinon un désaccord relancerait le suivi en boucle
        if not self.busy and not self.following and op_running():
            GLib.idle_add(lambda: self.follow_running() and False)

