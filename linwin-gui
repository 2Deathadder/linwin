def load_config():
    for path in (CONFIG, LEGACY_CONFIG):
        try:
            with open(path) as f:
                return json.load(f)
        except (OSError, ValueError):
            pass
    return {}


def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    with open(CONFIG, "w") as f:
        json.dump(cfg, f, indent=2)


def make_spinner():
    """Adw.Spinner (libadwaita 1.6+), sinon Gtk.Spinner."""
    if hasattr(Adw, "Spinner"):
        return Adw.Spinner(visible=False)
    spinner = Gtk.Spinner(visible=False)
    spinner.start()
    return spinner


def reboot():
    """Redémarre avec ce que propose le système (systemd, elogind, sinon root)."""
    for cmd in (["systemctl", "reboot"], ["loginctl", "reboot"], ["pkexec", "reboot"]):
        if GLib.find_program_in_path(cmd[0]):
            subprocess.Popen(cmd)
            return


def find_iso():
    for pattern in ("~/Downloads/**/Win10*.iso", "~/Downloads/**/*indows*10*.iso"):
        hits = glob.glob(os.path.expanduser(pattern), recursive=True)
        if hits:
            return max(hits, key=os.path.getmtime)
    return ""


class Step:
    """Une ligne d'étape : icône d'état + titre + bouton d'action."""

    def __init__(self, number, title, button_label, on_click, destructive=False):
        self.row = Adw.ActionRow(title=f"{number}. {title}")
        self.icon = Gtk.Image(icon_name=ICON_WAIT)
        self.row.add_prefix(self.icon)
        self.button = Gtk.Button(label=button_label, valign=Gtk.Align.CENTER)
        self.button.add_css_class("destructive-action" if destructive else "suggested-action")
        self.button.connect("clicked", lambda *_: on_click())
        self.row.add_suffix(self.button)

    def set(self, state, subtitle, enabled):
        icon, css = {
            "done": (ICON_DONE, "step-done"),
            "todo": (ICON_TODO, "step-todo"),
            "blocked": (ICON_BLOCKED, "step-blocked"),
            "wait": (ICON_WAIT, None),
        }[state]
        self.icon.set_from_icon_name(icon)
        for c in ("step-done", "step-todo", "step-blocked"):
            self.icon.remove_css_class(c)
        if css:
            self.icon.add_css_class(css)
        self.row.set_subtitle(GLib.markup_escape_text(subtitle))
        self.button.set_sensitive(enabled)
        self.button.set_visible(state != "done" and (state != "wait" or enabled))


