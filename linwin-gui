            self.row_iso.set_subtitle(GLib.markup_escape_text(f"{os.path.basename(iso)} — {size:.1f} Gio"))
        else:
            self.row_iso.set_subtitle("Aucune image choisie : télécharge-la ou choisis un fichier .iso")

    def update_driver_row(self):
        drv = self.cfg.get("driver", "")
        self.row_driver.set_subtitle(GLib.markup_escape_text(drv) if drv else DEFAULT_DRIVER)

    def update_view(self):
        st = self.status
        err = st.get("error")
        iso_ok = os.path.isfile(self.cfg.get("iso", ""))
        vmd = st.get("vmd", False)
        prepared, finished = st.get("prepared", False), st.get("finished", False)
        needs_reboot = st.get("needs_reboot", False)
        staged, bootnext = st.get("staged", False), st.get("bootnext", False)
        win_installed = st.get("windows_installed", False)

        # bandeau
        if err:
            self.banner.set_title(GLib.markup_escape_text(f"Configuration non gérée : {err}"))
            self.banner.set_button_label(None)
            self.banner.set_revealed(True)
        elif vmd and not staged and not finished:
            self.banner.set_title("Intel VMD est actif : son pilote sera ajouté à l'installeur Windows.")
            self.banner.set_button_label("Détails")
            self.banner.set_revealed(True)
        else:
            self.banner.set_revealed(False)

        # machine
        self.row_system.set_subtitle(GLib.markup_escape_text(
            f"{st.get('distro', 'Linux')} — chargeur {st.get('loader_label', '?')}, init {st.get('init', '?')}"))
        if st.get("disk"):
            self.row_disk.set_subtitle(f"/dev/{st['disk']} (celui de la partition EFI) — Linux : {st.get('root_fs', '?')} "
                                       f"sur /dev/{st.get('part', '?')}" + (", chiffré (LUKS)" if st.get("luks") else ""))
            space = f"{st.get('free_gib', 0)} Gio non alloués → jusqu'à {st.get('free_max_gib', 0)} Gio sans rien redimensionner"
            if st.get("shrink_ok"):
                space += f" ; en réduisant Linux (Btrfs) : jusqu'à {st.get('shrink_max_gib', 0)} Gio"
            else:
                space += f" ; Linux ne peut pas être réduit : {st.get('shrink_why', '')}"
            self.row_space.set_subtitle(GLib.markup_escape_text(space))
        else:
            self.row_disk.set_subtitle("—")
            self.row_space.set_subtitle("—")
        esp = st.get("esp_free_mib", 0)
        self.row_esp.set_subtitle(GLib.markup_escape_text(
            f"{st.get('esp_dev', '?')} sur {st.get('esp_dir', '?')} — {esp} Mio libres"
            + ("" if esp >= 100 else " — Windows a besoin d'environ 100 Mio")))
        if not vmd:
            self.row_vmd.set_subtitle("Inactif")
        elif st.get("vmd_rst"):
            self.row_vmd.set_subtitle("Actif — pilote Intel RST " + ("déjà téléchargé" if st.get("vmd_driver_cached") else "téléchargé à l'étape 2"))
        else:
            self.row_vmd.set_subtitle(f"Actif ({st.get('vmd_ids', '?')}) — pilote cherché dans le catalogue Microsoft à l'étape 2")
        net = st.get("net", [])
        if not net:
            self.row_net.set_subtitle("Aucune carte réseau PCI détectée")
        else:
            names = ", ".join(n["name"] for n in net)
            if st.get("net_drivers"):
                state = f"{st['net_drivers']} pilote(s) ajouté(s) à l'installeur"
            elif finished or win_installed:
                state = "pilotes absents de ce Windows : « Pilotes » ci-dessous"
            elif staged:
                state = "aucun pilote ajouté : voir le journal de l'étape 2"
            else:
                state = "pilotes du catalogue Microsoft Update ajoutés à l'étape 2"
            self.row_net.set_subtitle(GLib.markup_escape_text(f"{names} — {state}"))
        self.row_license.set_subtitle("Présente : choisis Famille pour une activation automatique" if st.get("oem_license")
                                      else "Absente : il faudra activer Windows avec ta propre licence")
        on_ac = st.get("on_ac", True)
        self.row_power.set_subtitle("Sur secteur" if on_ac else "Sur batterie — branche le chargeur")
        self.row_trust.set_subtitle(f"Oui : {INSTALLED_CLI}" if st.get("installed")
                                    else "Pas encore : proposé à la première étape qui demande root")

        max_win = st.get("max_win_gib", 0)
        if max_win >= 32:
            self.row_size.get_adjustment().set_upper(max_win)
        # verrouillés seulement pendant une installation en cours : une fois terminée
        # (ou annulée), on peut de nouveau tout régler
        locked = prepared and not finished
        self.row_size.set_sensitive(not locked and not self.busy)
        self.row_plan.set_sensitive(not locked)

        # étapes
        if finished:
            self.s_prepare.set("done", "Disque partitionné — « Annuler l'installation » pour recommencer", False)
        elif prepared:
            sub = "Redémarre Linux pour que le noyau voie les nouvelles partitions" if needs_reboot else \
                f"Partition Windows n°{st['win_num']} créée, Linux sur la n°{st['part_num']}"
            self.s_prepare.set("blocked" if needs_reboot else "done", sub, False)
        elif err:
            self.s_prepare.set("blocked", "Disque non géré par l'outil", False)
        elif not on_ac:
            self.s_prepare.set("blocked", "Branche le chargeur : une coupure ici peut détruire Linux", False)
        elif not iso_ok:
            self.s_prepare.set("blocked", "Choisis d'abord l'image ISO (dans Réglages)", False)
        else:
            self.s_prepare.set("todo", "Réduit Linux et crée les partitions MSR, Windows et WINSETUP", not self.busy)

        # une fois l'installeur copié, le mode est celui enregistré par la CLI
        in_progress = staged and not finished
        auto = st.get("unattended", False) if in_progress else self.row_auto.get_active()
        self.row_auto.set_sensitive(not in_progress and not self.busy)
        for r in self.auto_rows:
            r.set_sensitive(auto and not in_progress and not self.busy)
        auto_problem = self.auto_problem() if auto else None

        if finished or staged:
            self.s_stage.set("done", "Installeur copié sur WINSETUP" + (", en mode sans intervention" if auto else ""), False)
        elif not prepared or needs_reboot:
            self.s_stage.set("wait", "Après l'étape 1", False)
        elif not iso_ok:
            self.s_stage.set("blocked", "Choisis d'abord l'image ISO", False)
        elif not on_ac:
            self.s_stage.set("blocked", "Branche le chargeur", False)
        elif auto_problem:
            self.s_stage.set("blocked", auto_problem, False)
        elif auto:
            self.s_stage.set("todo", f"Copie l'ISO, extrait l'édition {EDITIONS[self.row_edition.get_selected()][1]} "
                             "et prépare les réponses automatiques", not self.busy)
        else:
            self.s_stage.set("todo", "Formate WINSETUP et y copie l'ISO", not self.busy)

        if finished or win_installed:
            self.s_boot.set("done", "Installeur démarré", False)
        elif bootnext:
            self.s_boot.set("todo", "Programmé : redémarre pour lancer l'installeur", not self.busy)
            self.s_boot.button.set_label("Redémarrer")
        elif staged:
            self.s_boot.set("todo", "Démarre l'installeur au prochain redémarrage (une seule fois)", not self.busy)
            self.s_boot.button.set_label("Programmer")
        else:
            self.s_boot.set("wait", "Après l'étape 2", False)

        if finished or win_installed:
            self.s_install.set("done", "Windows est installé", False)
        elif auto:
            self.s_install.set("wait", "Automatique : rien à faire, compter 20 à 40 minutes", True)
        elif bootnext or staged:
            self.s_install.set("wait", f"Dans l'installeur : partition n°{st.get('win_setup_id') or st.get('win_num') or '?'} uniquement", True)
        else:
            self.s_install.set("wait", "Se fait dans l'installeur Windows", True)

        if finished:
            self.s_finish.set("done", f"Terminé : Windows est dans le menu de {st.get('loader_label', '?')}", False)
        elif prepared and win_installed:
            self.s_finish.set("todo", f"Remet Linux en premier, supprime WINSETUP, ajoute Windows au menu de {st.get('loader_label', '?')}", not self.busy)
        elif auto:
            self.s_finish.set("wait", "Automatique au retour sous Linux", False)
        else:
            self.s_finish.set("wait", "Après l'installation de Windows", False)

        # pilotes : pour un Windows installé sans eux (ou pour les réinstaller)
        self.drivers_group.set_visible(bool(net) and (finished or win_installed))
        self.drivers_button.set_sensitive(not self.busy)

        # annulation : possible dès que l'outil a modifié le disque
        self.cancel_group.set_visible(prepared or finished)
        if win_installed or finished:
            self.row_cancel.set_subtitle(f"Supprime Windows (partition n°{st.get('win_num') or '?'}, avec son contenu) "
                                         + ("et rend tout son espace à Linux" if st.get("mode") == "shrink" else "; l'espace redevient libre"))
        else:
            self.row_cancel.set_subtitle("Supprime les partitions créées" + (" et rend leur espace à Linux" if st.get("mode") == "shrink" else ""))
        self.cancel_button.set_sensitive(not self.busy and on_ac)

        if not locked and not self.plan_label.get_label():
            self.on_size_changed()

    # --- réglages ----------------------------------------------------------------

    def on_size_changed(self):
        self.cfg["size"] = int(self.row_size.get_value())
        save_config(self.cfg)
        if self.plan_timer:
            GLib.source_remove(self.plan_timer)
        self.plan_timer = GLib.timeout_add(300, self.update_plan)

    def on_auto_changed(self):
        self.cfg["unattended"] = self.row_auto.get_active()
        self.cfg["edition"] = EDITIONS[self.row_edition.get_selected()][0]
        self.cfg["user"] = self.row_user.get_text()
        save_config(self.cfg)
        self.update_view()

    def auto_problem(self):
        """Ce qui empêche le mode sans intervention, ou None."""
        user = self.row_user.get_text()
        if not USER_RE.match(user):
            return "Nom du compte invalide (lettres, chiffres, - et _, 20 max)"
        if user.lower() in RESERVED_USERS:
            return f"« {user} » est réservé par Windows"
        return None

    def update_plan(self):
        self.plan_timer = 0
        r = subprocess.run([LOCAL_CLI, "plan", "--size", f"{self.cfg['size']}G"], capture_output=True, text=True)
        text = (r.stdout + r.stderr).strip()
        self.plan_label.set_label(text)
        lines = text.splitlines()
        line = next((l for l in lines if "taille" in l or "Espace utilisé" in l), lines[-1] if lines else "")
        if "taille" in line:
            line = "Linux réduit : " + line.split(":", 1)[-1].strip()
        elif "Espace utilisé" in line:
            line = "Espace non alloué : aucune partition existante modifiée"
        self.row_plan.set_subtitle(GLib.markup_escape_text(line))
        return False

    def pick_iso(self):
        dialog = Gtk.FileDialog(title="Image Windows 10")
        f = Gtk.FileFilter(name="Images ISO")
        f.add_pattern("*.iso")
        f.add_pattern("*.ISO")
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(f)
        dialog.set_filters(filters)
        dialog.set_initial_folder(Gio.File.new_for_path(os.path.expanduser("~/Downloads")))

        def done(d, res):
            try:
                path = d.open_finish(res).get_path()
            except GLib.Error:
                return
            self.cfg["iso"] = path
            save_config(self.cfg)
            self.update_iso_row()
            self.update_view()

        dialog.open(self, None, done)

    def download_iso(self):
        def done(code, output):
            ok = [l for l in output if l.startswith("OK : ")]
            if code == 0 and ok:
                self.cfg["iso"] = ok[-1][5:]
                save_config(self.cfg)
                self.update_iso_row()
                self.update_view()
                self.toast("Image Windows 10 téléchargée")
            else:
                self.toast("Microsoft a refusé le téléchargement automatique", "Ouvrir la page", self.open_ms_page)

        self.run(["iso"], on_done=done)

    def open_ms_page(self):
        Gtk.UriLauncher.new(WIN10_PAGE).launch(self, None, None)
        self.toast("Choisis : Windows 10 → Français → 64-bit, puis « Choisir… » pour l'ISO")

    def pick_driver(self):
        dialog = Gtk.FileDialog(title="Dossier du pilote VMD (contient un fichier .inf)")

        def done(d, res):
            try:
                path = d.select_folder_finish(res).get_path()
            except GLib.Error:
                return
            if not glob.glob(os.path.join(path, "*.inf")):
                self.toast("Ce dossier ne contient aucun fichier .inf")
                return
            self.set_driver(path)

        dialog.select_folder(self, None, done)

    def set_driver(self, path):
        self.cfg["driver"] = path
        save_config(self.cfg)
        self.update_driver_row()
        self.update_view()

    # --- étapes ------------------------------------------------------------------

    def do_prepare(self):
        st = self.status
        size = self.cfg["size"]
        # même règle que la CLI : l'espace non alloué d'abord, la réduction de Linux sinon
        shrink = size > st.get("free_max_gib", 0)
        if shrink:
            body = (f"Linux va être réduit et {size} Gio seront réservés à Windows, plus 8 Gio pour l'installeur.\n\n"
                    "Btrfs et LUKS sont réduits avant la partition, avec une marge, et chaque étape est vérifiée. "
                    "Mais une coupure de courant pendant l'opération peut rendre Linux inutilisable : "
                    "sans sauvegarde, les données seraient perdues. Branche le chargeur.")
        else:
            body = (f"{size} Gio d'espace non alloué seront réservés à Windows, plus 8 Gio pour l'installeur.\n\n"
                    "Aucune partition existante n'est modifiée : trois partitions sont ajoutées dans l'espace libre.")
        dialog = Adw.AlertDialog(heading="Modifier les partitions ?", body=body)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        group = Adw.PreferencesGroup()
        confirm = Adw.EntryRow(title="Tape OUI pour confirmer")
        group.add(confirm)
        password = None
        if shrink and st.get("luks"):
            password = Adw.PasswordEntryRow(title="Passphrase du disque chiffré")
            group.add(password)
        box.append(group)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Annuler")
        dialog.add_response("go", "Préparer le disque")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_response_enabled("go", False)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")

        def validate(*_):
            ok = confirm.get_text() == "OUI" and (password is None or password.get_text() != "")
            dialog.set_response_enabled("go", ok)

        confirm.connect("changed", validate)
        if password:
            password.connect("changed", validate)

        def response(d, res):
            if d.choose_finish(res) != "go":
                return
            argv = ["prepare", "--size", f"{size}G", "--yes"]
            stdin = None
            if password:
                argv.append("--key-stdin")
                stdin = password.get_text() + "\n"

            def done(code, output):
                if code == 0:
                    self.toast("Disque préparé")
                else:
                    self.toast("La préparation a échoué : voir le journal")

            self.run(argv, root=True, stdin=stdin, on_done=done)

        dialog.choose(self, None, response)

    def do_stage(self):
        argv = ["stage", "--iso", self.cfg["iso"]]
        if self.status.get("vmd") and self.cfg.get("driver"):
            argv += ["--vmd-driver", self.cfg["driver"]]
        stdin = None
        if self.row_auto.get_active():
            edition = EDITIONS[self.row_edition.get_selected()][0]
            argv += ["--edition", edition, "--user", self.row_user.get_text(), "--password-stdin"]
            stdin = self.row_password.get_text() + "\n"

        def done(code, _):
            if code == 0:
                # effacé seulement après succès : un nouvel essai garde le même mot de passe
                self.row_password.set_text("")
                self.toast("Installeur copié")
            else:
                self.toast("La copie a échoué : voir le journal")

        self.run(argv, root=True, stdin=stdin, on_done=done)

    def do_boot(self):
        if self.status.get("bootnext"):
            self.confirm_reboot()
            return

        def done(code, _):
            if code == 0:
                self.confirm_reboot()
            else:
                self.toast("Échec : voir le journal")

        self.run(["boot"], root=True, on_done=done)

    def ask_install(self, then):
        update = trusted(INSTALLED_CLI)
        dialog = Adw.AlertDialog(
            heading="Mettre à jour l'outil installé" if update else "Installer l'outil d'abord",
            body=("Les étapes qui modifient le système s'exécutent en root. Pour qu'aucun programme de ta session "
                  "ne puisse modifier ce qui est lancé en root, l'outil est d'abord copié en root:root dans "
                  f"{os.path.dirname(INSTALLED_CLI)}.\n\n"
                  f"Copie depuis :\n{HERE}\n\n"
                  "Si tu modifies ces fichiers plus tard, relance l'installation."))
        dialog.add_response("cancel", "Annuler")
        dialog.add_response("install", "Installer")
        dialog.set_response_appearance("install", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_close_response("cancel")

        def response(d, res):
            if d.choose_finish(res) != "install":
                return

            def done(code, _):
                if code == 0 and trusted(INSTALLED_CLI):
                    self.toast("Outil installé")
                    GLib.idle_add(lambda: then() and False)
                else:
                    self.toast("Installation impossible : voir le journal")

            self.run(["install"], root=True, on_done=done, bootstrap=True)

        dialog.choose(self, None, response)

    def confirm_reboot(self):
        dialog = Adw.AlertDialog(heading="Redémarrer vers l'installeur ?", body=self.install_text())
        dialog.add_response("later", "Plus tard")
        dialog.add_response("reboot", "Redémarrer maintenant")
        dialog.set_response_appearance("reboot", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_close_response("later")

        def response(d, res):
            if d.choose_finish(res) == "reboot":
                reboot()

        dialog.choose(self, None, response)

    def install_text(self):
        st = self.status
        if st.get("unattended"):
            return ("L'installation est entièrement automatique : ne touche à rien pendant 20 à 40 minutes.\n\n"
                    "1. L'installeur formate uniquement la partition Windows, après l'avoir identifiée à l'octet près.\n"
                    "2. Windows crée ton compte local et ouvre une première session tout seul.\n"
                    f"3. Il redémarre sous Linux, qui finalise au démarrage : Windows apparaît ensuite dans le menu de {st.get('loader_label', '?')}.\n\n"
                    "Si la partition n'est pas reconnue, l'installeur passe en mode manuel par sécurité : "
                    f"choisis alors uniquement la partition n°{st.get('win_setup_id') or st.get('win_num') or '?'}.\n"
                    "Laisse le chargeur branché.")
        return ("Dans l'installeur Windows :\n"
                "1. « Je n'ai pas de clé de produit » si tu n'en as pas, puis choisis l'édition.\n"
                "2. Type d'installation : « Personnalisée ».\n"
                f"3. Sélectionne UNIQUEMENT « Lecteur 0 Partition {st.get('win_setup_id') or st.get('win_num') or '?'} » "
                f"({self.cfg.get('size', 100)} Go), clique « Formater » si demandé, puis « Suivant ».\n"
                "Ne touche à AUCUNE autre partition : elles appartiennent à Linux ou au système.\n"
                + ("Si aucun disque n'apparaît (Intel VMD) : « Charger un pilote » → Parcourir → "
                   "WINSETUP\\$WinPEDriver$\\vmd.\n" if st.get("vmd") else "")
                + "\n"
                "Une fois Windows installé, reviens sous Linux par le menu de démarrage UEFI "
                "(F8, F11 ou F12 selon le PC) et ouvre cette application pour finaliser.")

    def show_install_help(self):
        dialog = Adw.AlertDialog(heading="Installer Windows", body=self.install_text())
        dialog.add_response("ok", "Compris")
        dialog.present(self)

    def show_vmd_help(self):
        dialog = Adw.AlertDialog(
            heading="Intel VMD et pilote RST",
            body=("Ton SSD est derrière le contrôleur Intel VMD (RST). L'installeur de Windows 10 n'a pas ce pilote "
                  "et ne verrait aucun disque.\n\n"
                  + ("L'étape 2 télécharge donc chez Intel le pilote RST 20.2.6.1025 (iaStorVD, signé WHQL par "
