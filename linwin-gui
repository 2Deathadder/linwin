def op_running():
    """Vrai si une opération de la CLI tient son verrou (lu dans /proc/locks, sans le prendre)."""
    try:
        ino = os.stat(LOCK).st_ino
        with open("/proc/locks") as f:
            return any(l.split()[1] == "FLOCK" and l.split()[5].endswith(f":{ino}") for l in f if len(l.split()) > 5)
    except OSError:
        return False


def trusted(path):
    """root:root et non modifiable par d'autres, dossiers parents compris."""
    try:
        if os.path.islink(path) or not os.path.isfile(path):
            return False
        p = path
        while True:
            st = os.stat(p)
            if st.st_uid != 0 or st.st_mode & 0o022:
                return False
            if p == "/":
                return True
            p = os.path.dirname(p)
    except OSError:
        return False


def cli():
    """La CLI à lancer en root : la copie de confiance si elle existe."""
    return INSTALLED_CLI if trusted(INSTALLED_CLI) else LOCAL_CLI


def outdated():
    """Vrai si la copie installée diffère des fichiers de ce dossier (mise à jour à installer)."""
    installed_dir = os.path.dirname(INSTALLED_CLI)
    for name in ("linwin", "linwin-gui"):
        try:
            with open(os.path.join(HERE, name), "rb") as a, open(os.path.join(installed_dir, name), "rb") as b:
                if a.read() != b.read():
                    return True
        except OSError:
            return True
    return False
