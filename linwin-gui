                     if self.status.get("vmd_rst") else
                     "L'étape 2 cherche donc le pilote de ton contrôleur dans le catalogue Microsoft Update (signé WHQL), "
                     "vérifie son empreinte et qu'il le déclare ")
                  + f"({self.status.get('vmd_ids') or '?'}), puis l'ajoute :\n"
                  "• à l'installeur, qui le charge avant de chercher le disque ;\n"
                  "• au Windows installé, pour qu'il démarre ensuite sur ce SSD.\n\n"
                  "Rien à changer dans le BIOS. « Choisir… » permet d'utiliser un autre pilote F6 (dossier avec iaStorVD.inf)."))
        dialog.add_response("ok", "Compris")
        dialog.present(self)

    def do_finish(self):
        dialog = Adw.AlertDialog(
            heading="Finaliser ?",
            body=("Le chargeur de Linux redevient le premier choix au démarrage, la partition WINSETUP est supprimée "
                  f"et Windows est ajouté au menu de {self.status.get('loader_label', '?')}."))
        dialog.add_response("cancel", "Annuler")
        dialog.add_response("go", "Finaliser")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_close_response("cancel")

        def response(d, res):
            if d.choose_finish(res) == "go":
                self.run(["finish"], root=True, on_done=lambda code, _: self.toast(
                    f"Terminé : Windows est dans le menu de {self.status.get('loader_label', '?')}" if code == 0 else "Échec : voir le journal"))

        dialog.choose(self, None, response)


    def do_drivers(self):
        self.run(["drivers"], root=True, on_done=lambda code, _: self.toast(
            "Copié : sous Windows, lance C:\\linwin\\installer-pilotes.cmd" if code == 0 else "Échec : voir le journal"))

    def do_cancel(self):
        st = self.status
        windows = st.get("windows_installed") or st.get("finished")
        dialog = Adw.AlertDialog(
            heading="Supprimer Windows ?" if windows else "Annuler l'installation ?",
            body=(("Windows et TOUT ce qu'il contient seront supprimés, ainsi que ses entrées de démarrage. "
                   if windows else "Les partitions créées par l'outil seront supprimées. ")
                  + ("Leur espace est ensuite rendu à Linux (partition, LUKS et Btrfs agrandis à chaud).\n\n"
                     "Agrandir est moins risqué que réduire, mais garde le chargeur branché."
                     if st.get("mode") == "shrink" else "Leur espace redevient non alloué ; Linux n'est pas modifié.")))
        group = Adw.PreferencesGroup()
        confirm = Adw.EntryRow(title="Tape OUI pour confirmer")
        group.add(confirm)
        password = None
        if st.get("mode") == "shrink" and st.get("luks"):
            password = Adw.PasswordEntryRow(title="Passphrase du disque chiffré")
            group.add(password)
        dialog.set_extra_child(group)
        dialog.add_response("cancel", "Ne rien faire")
        dialog.add_response("go", "Supprimer Windows" if windows else "Annuler l'installation")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_response_enabled("go", False)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")

        def validate(*_):
            dialog.set_response_enabled("go", confirm.get_text() == "OUI" and (password is None or password.get_text() != ""))

        confirm.connect("changed", validate)
        if password:
            password.connect("changed", validate)

        def response(d, res):
            if d.choose_finish(res) != "go":
                return
            argv = ["cancel", "--yes"]
            stdin = None
            if password:
                argv.append("--key-stdin")
                stdin = password.get_text() + "\n"

            def done(code, _):
                if code == 0:
                    self.toast("Installation annulée")
                elif code == 3:
                    self.toast("Redémarre Linux, puis relance l'annulation")
                else:
                    self.toast("L'annulation a échoué : voir le journal")
                # le partitionnement prévu a changé
                self.plan_label.set_label("")
                self.on_size_changed()

            self.run(argv, root=True, stdin=stdin, on_done=done)

        dialog.choose(self, None, response)


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_startup(self):
        Adw.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self):
        win = self.get_active_window() or Window(self)
        win.present()


if __name__ == "__main__":
    if not ADW_OK:
        version = f"{Adw.get_major_version()}.{Adw.get_minor_version()}"
        msg = (f"linwin-gui demande libadwaita 1.5 ou plus récent (installé : {version}).\n"
               f"Utilise la ligne de commande : {LOCAL_CLI} --help")
        print(msg, file=sys.stderr)
        if GLib.find_program_in_path("notify-send"):
            subprocess.run(["notify-send", "linwin", msg])
        sys.exit(1)
    sys.exit(App().run(sys.argv))
