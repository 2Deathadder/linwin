# Langue de l'ISO, lue dans sources/lang.ini (« fr-fr = 3 » → fr-FR). Une
# langue absente de l'image ferait échouer l'installation sans intervention.
iso_locale() {
  local lang
  lang=$(tr -d '\0\r' <"$1/sources/lang.ini" 2>/dev/null |
    sed -n '/^\[Available UI Languages\]/,/^\[/{s/^\([A-Za-z]\{2\}\)-\([A-Za-z]\{2\}\) *=.*/\1-\2/p}' | sed -n 1p || true)
  [[ $lang =~ ^[A-Za-z]{2}-[A-Za-z]{2}$ ]] || die "langue de l'ISO illisible (sources/lang.ini)"
  echo "${lang:0:2}" | tr A-Z a-z | tr -d '\n'
  echo "-${lang:3:2}" | tr a-z A-Z
}

