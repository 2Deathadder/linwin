  local problem
  if problem=$(platform_problem); then
    echo "PC NON COMPATIBLE : $problem"
    return 1
  fi
  detect
  echo "Partition EFI : $ESP_DEV montée sur $ESP_DIR (disque /dev/$DISK, GPT) — Windows ira sur ce disque"
  local esp_avail
  esp_avail=$(findmnt -bno AVAIL -M "$ESP_DIR" 2>/dev/null || echo 0)
  echo "  $((esp_avail / 1048576)) Mio libres$( ((esp_avail >= 100 * 1048576)) && echo ", OK" || echo " — Windows a besoin d'environ 100 Mio")"
  echo "Chargeur de Linux : $(loader_label "$(boot_loader_kind)")"
  echo "Racine : $ROOT_FS sur /dev/$ROOT_PART$( ((LUKS)) && echo ", dans LUKS « $DM_NAME »")"
  echo "Espace non alloué sur /dev/$DISK : $(gib "$FREE_SIZE") d'un seul tenant → Windows jusqu'à $(free_max_gib) Gio sans rien redimensionner"
  if ((SHRINK_OK)); then
    echo "Réduction à chaud de Linux : possible (Btrfs : $((BTRFS_SIZE / 1073741824)) Gio, dont $((BTRFS_UNALLOC / 1073741824)) non alloués) → jusqu'à $(shrink_max_gib) Gio"
  else
    echo "Réduction à chaud de Linux : impossible — $SHRINK_WHY"
  fi
  echo "Licence Windows dans le firmware : $(oem_license && echo 'oui (édition Famille en général)' || echo non)"
  echo "Alimentation : $( (require_ac) 2>/dev/null && echo 'secteur, OK' || echo 'SUR BATTERIE — branche le chargeur')"
  echo "Copie installée sûre : $(installed_trusted && echo "oui ($INSTALLED_BIN)" || echo "non — lance « install »")"
  if vmd_active; then
    echo "Intel VMD : ACTIF (contrôleur $(vmd_ids | paste -sd ' ')) — sans pilote, l'installeur Windows 10 ne verrait pas le SSD."
    if rst_covers; then
      echo "  → « stage » ajoutera le pilote Intel RST (iaStorVD 20.2.6.1025) à l'installeur."
    else
      echo "  → « stage » cherchera le pilote de ce contrôleur dans le catalogue Microsoft Update."
    fi
  else
    echo "Intel VMD : inactif, OK"
  fi
  local id name
  while IFS='|' read -r id name; do
    [[ -n $id ]] && echo "Réseau : $name ($id) → pilote cherché dans le catalogue Microsoft Update par « stage »"
  done < <(net_devices)
  local sb
  sb=$(od -An -t u1 /sys/firmware/efi/efivars/SecureBoot-* 2>/dev/null | awk '{print $NF}' || true)
  echo "Secure Boot : $([[ $sb == 1 ]] && echo activé || echo désactivé)"
  local t
  for t in efibootmgr sfdisk partx wipefs mkfs.fat wimlib-imagex cabextract curl python3; do
    command -v "$t" >/dev/null && echo "$t : OK" || echo "$t : absent (installé automatiquement si besoin)"
  done
  [[ -f $STATE ]] && { echo "État existant :"; sed 's/^/  /' "$STATE"; }
  return 0
}

