# Fuseau horaire de Linux (systemd ou non)
linux_tz() {
  local t=""
  command -v timedatectl >/dev/null && t=$(timedatectl show -p Timezone --value 2>/dev/null || true)
  [[ -z $t && -r /etc/timezone ]] && t=$(head -1 /etc/timezone)
  [[ -z $t && -L /etc/localtime ]] && t=$(readlink -f /etc/localtime | sed -n 's|.*/zoneinfo/||p')
  echo "${t:-UTC}"
}

# Disposition clavier de Linux (code XKB : fr, us, de…), systemd ou non
kbd_layout() {
  local l=""
  command -v localectl >/dev/null && l=$(localectl status 2>/dev/null | awk '/X11 Layout:/ {print $3}' | cut -d, -f1)
  [[ -z $l && -r /etc/default/keyboard ]] && l=$(. /etc/default/keyboard 2>/dev/null; echo "${XKBLAYOUT%%,*}")
  [[ -z $l && -r /etc/X11/xorg.conf.d/00-keyboard.conf ]] &&
    l=$(awk '/XkbLayout/ {gsub(/"/, "", $3); print $3}' /etc/X11/xorg.conf.d/00-keyboard.conf | cut -d, -f1)
  [[ -z $l && -r /etc/vconsole.conf ]] && l=$(. /etc/vconsole.conf 2>/dev/null; echo "${KEYMAP:-}")
  [[ -z $l && -r /etc/conf.d/keymaps ]] && l=$(. /etc/conf.d/keymaps 2>/dev/null; echo "${keymap:-}")
  l=${l%%-*}   # « fr-latin9 » (console) → fr
  echo "${l:-us}"
}

