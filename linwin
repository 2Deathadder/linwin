  source "$STATE"
}

# --- détection du disque ---------------------------------------------------------

# Windows va sur le disque de la partition EFI : c'est là que son gestionnaire de
# démarrage s'installe. Remplit : ESP_* DISK DISK_SECTORS LAST_LBA FREE_START
# FREE_SIZE, puis (detect_root) ROOT_* SHRINK_OK SHRINK_WHY PART PART_NUM START
# SIZE LUKS DM_NAME OFFSET BTRFS_DEVID BTRFS_SIZE BTRFS_UNALLOC
detect() {
  local problem
  if problem=$(platform_problem); then die "$problem"; fi
  find_esp || die "partition EFI introuvable : elle doit être montée (/boot/efi, /efi ou /boot)"
  DISK=$ESP_DISK
  disk_label | grep -qx -e gpt -e '' ||
    die "le disque /dev/$DISK n'est pas en GPT : Windows en UEFI exige une table GPT"
  [[ $(<"/sys/block/$DISK/queue/logical_block_size") == 512 ]] || die "disque à secteurs logiques ≠ 512 octets : non géré"
  DISK_SECTORS=$(<"/sys/block/$DISK/size")
  LAST_LBA=$((DISK_SECTORS - 34))
  find_free
  detect_root
}

# Type de table du disque (gpt, dos…), vide si inconnu : udev d'abord (sans root),
# puis lecture directe (root). « prepare » exige qu'il soit connu.
disk_label() {
  local t
  t=$(lsblk -dno PTTYPE "/dev/$DISK" 2>/dev/null || true)
  [[ -z $t ]] && t=$(blkid -p -s PTTYPE -o value "/dev/$DISK" 2>/dev/null || true)
  echo "$t"
}

# Plus grande zone non allouée du disque, alignée sur 1 Mio : FREE_START, FREE_SIZE
# (en secteurs). D'après /sys : lisible sans être root.
find_free() {
  local prev=$ALIGN_SECTORS s e a size d
  FREE_START=0 FREE_SIZE=0
  while read -r s e; do
    a=$(((prev + ALIGN_SECTORS - 1) / ALIGN_SECTORS * ALIGN_SECTORS))
    size=$(((s - a) / ALIGN_SECTORS * ALIGN_SECTORS))
    ((size > FREE_SIZE)) && FREE_START=$a FREE_SIZE=$size
    ((e > prev)) && prev=$e
  done < <(
    for d in /sys/block/"$DISK"/"$DISK"*; do
      [[ -f $d/start ]] && echo "$(<"$d/start") $(($(<"$d/start") + $(<"$d/size")))"
    done | sort -n
    echo "$((LAST_LBA + 1)) $((LAST_LBA + 1))"
  )
}

# La racine peut-elle céder de la place à chaud ? Seulement en Btrfs (sur une
# partition du disque de l'ESP, éventuellement dans LUKS) : ext4 ne se réduit que
# démonté, XFS jamais. Sinon SHRINK_WHY dit pourquoi.
detect_root() {
  SHRINK_OK=0 SHRINK_WHY="" PART="" PART_NUM=0 START=0 SIZE=0 LUKS=0 DM_NAME="" OFFSET=0
  BTRFS_DEVID="" BTRFS_SIZE=0 BTRFS_UNALLOC=0
  ROOT_FS=$(findmnt -no FSTYPE /)
  ROOT_DEV=$(readlink -f "$(findmnt -no SOURCE / | sed 's/\[.*//')")
  local name=${ROOT_DEV##*/} slaves part="" pdisk
  ROOT_PART=$name
  if [[ -d /sys/block/$name/dm ]]; then
    if [[ $(<"/sys/block/$name/dm/uuid") == CRYPT-LUKS* ]]; then
      slaves=(/sys/block/"$name"/slaves/*)
      if ((${#slaves[@]} == 1)); then
        LUKS=1 DM_NAME=$(<"/sys/block/$name/dm/name") part=${slaves[0]##*/}
        ROOT_PART=$part
      else
        SHRINK_WHY="la racine chiffrée s'étend sur plusieurs périphériques"
      fi
    else
      SHRINK_WHY="la racine est sur LVM (ou un autre device-mapper) : réduction à chaud non gérée"
    fi
  elif [[ -b /dev/$name ]]; then
    part=$name
  else
    SHRINK_WHY="la racine ($ROOT_FS) n'est pas sur une partition"
  fi
  if [[ -n $part ]]; then
    if [[ ! -f /sys/class/block/$part/partition ]]; then
      SHRINK_WHY="la racine est sur /dev/$part, qui n'est pas une partition"
    else
      pdisk=$(basename "$(readlink -f "/sys/class/block/$part/..")")
      if [[ $pdisk != "$DISK" ]]; then
        SHRINK_WHY="Linux est sur /dev/$pdisk, pas sur le disque de la partition EFI (/dev/$DISK)"
      else
        PART=$part
        PART_NUM=$(<"/sys/class/block/$PART/partition")
        START=$(<"/sys/class/block/$PART/start")
        SIZE=$(<"/sys/class/block/$PART/size")
        ((LUKS)) && OFFSET=$((SIZE - $(<"/sys/block/$name/size")))
      fi
    fi
  fi
  if [[ -z $SHRINK_WHY && $ROOT_FS != btrfs ]]; then
    SHRINK_WHY="la racine est en $ROOT_FS : seul Btrfs se réduit pendant que Linux tourne"
  fi
  [[ -n $SHRINK_WHY ]] && return 0
  BTRFS_FSID=$(findmnt -no UUID /)
  local devs=(/sys/fs/btrfs/"$BTRFS_FSID"/devinfo/*)
  if ((${#devs[@]} != 1)); then
    SHRINK_WHY="Btrfs sur plusieurs périphériques : non géré"
    return 0
  fi
  BTRFS_DEVID=${devs[0]##*/}
  BTRFS_SIZE=$(btrfs filesystem usage -b / 2>/dev/null | awk '/Device size:/ {print $3}')
  BTRFS_UNALLOC=$(btrfs filesystem usage -b / 2>/dev/null | awk '/Device unallocated:/ {print $3}')
  if [[ $BTRFS_SIZE =~ ^[0-9]+$ && $BTRFS_UNALLOC =~ ^[0-9]+$ ]]; then
    SHRINK_OK=1
  else
    SHRINK_WHY="taille Btrfs illisible"
  fi
}

# Taille Windows maximale (Gio) de chaque source d'espace
free_max_gib() {
  local m=$(((FREE_SIZE / MIB - MSR_MIB - $(to_mib "$STAGE_DEFAULT")) / 1024))
  echo $((m < 0 ? 0 : m))
}
shrink_max_gib() {
  ((SHRINK_OK)) || { echo 0; return; }
  local m=$(((BTRFS_UNALLOC / 1048576 - HEADROOM_GIB * 1024 - MARGIN_MIB - MSR_MIB - $(to_mib "$STAGE_DEFAULT") - 1024) / 1024))
  echo $((m < 0 ? 0 : m))
}

# Calcule la géométrie pour WIN_MIB + STAGE_MIB. MODE : « free » (espace non
# alloué, rien n'est redimensionné) de préférence, sinon « shrink » (réduction de
# la partition Linux, les nouvelles partitions occupent la fin de son ancienne place).
compute_plan() {
  local need=$(((MSR_MIB + WIN_MIB + STAGE_MIB) * MIB))
  MODE="" NEW_SIZE=$SIZE NEW_INNER=0 BTRFS_TARGET=0 SHRINK_BYTES=0
  if [[ ${FORCE_MODE:-} != shrink ]] && ((FREE_SIZE >= need)); then
    MODE=free
    MSR_START=$FREE_START
  elif [[ ${FORCE_MODE:-} != free ]] && ((SHRINK_OK)); then
    MODE=shrink
    NEW_SIZE=$(((SIZE - need) / MIB * MIB))
    MSR_START=$((START + NEW_SIZE))
    NEW_INNER=$((NEW_SIZE - OFFSET))
    BTRFS_TARGET=$(((NEW_INNER - MARGIN_MIB * MIB) * 512))
    SHRINK_BYTES=$((BTRFS_SIZE - BTRFS_TARGET))
    ((SHRINK_BYTES + HEADROOM_GIB * 1073741824 <= BTRFS_UNALLOC)) ||
      die "pas assez d'espace libre dans Btrfs : il faut $((SHRINK_BYTES / 1073741824 + HEADROOM_GIB)) Gio non alloués, il y en a $((BTRFS_UNALLOC / 1073741824))"
  else
    local why="il faut $((need / MIB / 1024)) Gio d'un seul tenant non alloués sur /dev/$DISK, la plus grande zone libre fait $((FREE_SIZE / MIB / 1024)) Gio"
    ((SHRINK_OK)) || why+=", et Linux ne peut pas être réduit à chaud ($SHRINK_WHY)"
    [[ $FORCE_MODE == free ]] && why="mode free imposé : $why"
    die "pas assez de place : $why. Choisis une taille plus petite, ou libère de l'espace non alloué sur ce disque (par ex. en réduisant une partition depuis un système live avec GParted)."
  fi
  WIN_START=$((MSR_START + MSR_MIB * MIB))
  STAGE_START=$((WIN_START + WIN_MIB * MIB))
  STAGE_END=$((STAGE_START + STAGE_MIB * MIB - 1))
  ((STAGE_END <= LAST_LBA)) || die "le plan dépasse la fin du disque"
}

print_plan() {
  echo "Disque          : /dev/$DISK ($(gib "$DISK_SECTORS")), partition EFI $ESP_DEV ($ESP_DIR)"
  if [[ $MODE == free ]]; then
    echo "Espace utilisé  : zone non allouée de $(gib "$FREE_SIZE") — aucune partition existante n'est modifiée"
  else
    echo "Partition Linux : /dev/$PART (n°$PART_NUM)$( ((LUKS)) && echo " — LUKS « $DM_NAME », en-tête $((OFFSET / MIB)) Mio")"
    echo "  taille        : $(gib "$SIZE")  →  $(gib "$NEW_SIZE")"
    echo "  Btrfs         : réduit à $(gib $((BTRFS_TARGET / 512))) puis regrossi pour remplir la partition"
  fi
  echo "Nouvelles partitions$([[ $MODE == shrink ]] && echo " (à la place libérée, après la partition Linux)") :"
  echo "  MSR           : $MSR_MIB Mio"
  echo "  Windows       : $((WIN_MIB / 1024)) Gio   (cible de l'installation)"
  echo "  $STAGE_LABEL      : $((STAGE_MIB / 1024)) Gio   (installeur, supprimée après l'installation)"
}

parse_sizes() {
  WIN_MIB="" STAGE_MIB=$(to_mib "$STAGE_DEFAULT") ASSUME_YES=0 KEY_STDIN=0 FORCE_MODE=""
  while (($#)); do
    case $1 in
    --yes) ASSUME_YES=1; shift ;;
    --key-stdin) KEY_STDIN=1; shift ;;
    --size) WIN_MIB=$(to_mib "${2:?}"); shift 2 ;;
    --stage-size) STAGE_MIB=$(to_mib "${2:?}"); shift 2 ;;
    --mode) FORCE_MODE=${2:?}; [[ $FORCE_MODE =~ ^(free|shrink)$ ]] || die "--mode : free ou shrink"; shift 2 ;;
    *) die "option inconnue : $1" ;;
    esac
  done
  [[ -n $WIN_MIB ]] || die "précise la taille Windows, ex. --size 100G"
  ((WIN_MIB >= 32 * 1024)) || die "Windows 10 exige au moins 32 Gio (64 Gio ou plus conseillés)"
  ((STAGE_MIB >= 6 * 1024)) || die "la partition $STAGE_LABEL doit faire au moins 6 Gio"
}

