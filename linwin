}

cmd_iso() {
  local lang out_dir=$HOME/Downloads
  lang=$(iso_lang_default)
  while (($#)); do
    case $1 in
    --lang) lang=${2:?}; shift 2 ;;
    --out) out_dir=${2:?}; shift 2 ;;
    *) die "option inconnue : $1" ;;
    esac
  done
  local tmp session edition sku_id uri out
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  session=$(cat /proc/sys/kernel/random/uuid)

  step "Interrogation de Microsoft (Windows 10 22H2, $lang, x64)"
  curl -fsSL -A "$UA" "$WIN10_PAGE" -o "$tmp/page.html"
  edition=$(grep -oE '<option value="[0-9]+">Windows 10' "$tmp/page.html" | sed -n 1p | grep -oE '[0-9]+') ||
    die "édition introuvable sur $WIN10_PAGE"
  curl -fsS -A "$UA" "https://vlscppe.microsoft.com/tags?org_id=y6jn8c31&session_id=$session" -o /dev/null
  curl -fsS -A "$UA" -H "Referer: $WIN10_PAGE" -o "$tmp/sku.json" \
    "https://www.microsoft.com/software-download-connector/api/getskuinformationbyproductedition?profile=606624d44113&ProductEditionId=$edition&SKU=undefined&friendlyFileName=undefined&Locale=fr-FR&sessionID=$session"
  sku_id=$(python3 -c 'import json,sys; print(next(s["Id"] for s in json.load(open(sys.argv[1]))["Skus"] if s["Language"] == sys.argv[2]))' "$tmp/sku.json" "$lang") ||
    die "langue « $lang » introuvable (ex. French, English, English International)"
  curl -fsS -A "$UA" -H "Referer: $WIN10_PAGE" -o "$tmp/links.json" \
    "https://www.microsoft.com/software-download-connector/api/GetProductDownloadLinksBySku?profile=606624d44113&ProductEditionId=undefined&SKU=$sku_id&friendlyFileName=undefined&Locale=fr-FR&sessionID=$session"
  uri=$(python3 -c 'import json,sys; print(next(o["Uri"] for o in json.load(open(sys.argv[1])).get("ProductDownloadOptions", []) if "x64" in o["Uri"]))' "$tmp/links.json" 2>/dev/null) || {
    echo
    echo "Microsoft a refusé le téléchargement automatique (protection anti-robot « Sentinel », liée à l'IP)."
    echo "Télécharge l'ISO à la main — depuis Linux, la page propose directement l'ISO :"
    echo "  1. ouvre $WIN10_PAGE"
    echo "  2. Windows 10 (multi-edition ISO) → Confirmer → Français → 64-bit Download"
    echo "  3. puis : $(basename "$SELF") stage --iso ~/Downloads/Win10_22H2_French_x64*.iso"
    exit 1
  }
  mkdir -p "$out_dir"
  out=$out_dir/$(basename "${uri%%\?*}")
  step "Téléchargement vers $out"
  curl -fL -C - -A "$UA" -o "$out" "$uri"
  echo "SHA-256 (à comparer avec celui affiché sur la page Microsoft) :"
  sha256sum "$out"
  echo "OK : $out"
}

cmd_prepare() {
  as_root prepare "$@"
  parse_sizes "$@"
  [[ -f $STATE ]] && die "un état existe déjà ($STATE) : prepare a déjà été lancé"
  [[ -f $STATE.done ]] && die "Windows a déjà été installé par cet outil ($STATE.done)"
  detect
  require_ac
  compute_plan
  print_plan
  echo
  if [[ $MODE == free ]]; then
    echo "Cette étape ajoute trois partitions dans l'espace non alloué de /dev/$DISK ; aucune"
    echo "partition existante n'est modifiée."
  else
    cat <<EOF
Cette étape modifie la table de partitions du disque qui contient Linux.
Elle est conçue pour être sûre (Btrfs et LUKS sont réduits AVANT la partition,
avec une marge), mais une coupure de courant pendant l'opération ou un bug
peut rendre Linux inutilisable. Sans sauvegarde, les données seraient perdues.
Branche le chargeur.
EOF
  fi
  echo
  local answer key=""
  if ((KEY_STDIN)); then
    IFS= read -r key || [[ -n $key ]] || die "passphrase LUKS attendue sur l'entrée standard"
  fi
  if ((!ASSUME_YES)); then
    read -rp "Tape OUI en majuscules pour continuer : " answer
    [[ $answer == OUI ]] || die "annulé"
  fi
  local t
  for t in sfdisk partx efibootmgr python3; do ensure_tool "$t"; done
  [[ $(sfdisk --dump "/dev/$DISK" | awk '/^label:/ {print $2}') == gpt ]] ||
    die "le disque /dev/$DISK n'est pas en GPT : Windows en UEFI exige une table GPT"
  if [[ $MODE == shrink ]] && ((LUKS)) && [[ -n $key ]]; then
    phase 0 5 "Vérification de la passphrase LUKS (avant toute modification)"
    printf '%s' "$key" | cryptsetup open --test-passphrase --key-file=- "/dev/$PART" ||
      die "passphrase LUKS incorrecte : rien n'a été modifié"
  fi

  # LUKS2 peut redemander la passphrase pour redimensionner
  luks_resize() {
    if [[ -n $key ]]; then
      printf '%s' "$key" | cryptsetup resize --key-file=- "$@"
    else
      cryptsetup resize "$@"
    fi
  }

  mkdir -p "$STATE_DIR"
  sfdisk --dump "/dev/$DISK" >"$STATE_DIR/ptable-before.sfdisk"
  echo "Table de partitions sauvegardée : $STATE_DIR/ptable-before.sfdisk"

  if [[ $MODE == shrink ]]; then
    phase 5 60 "Réduction de Btrfs à $((BTRFS_TARGET / 1048576)) Mio (peut prendre plusieurs minutes)"
    sync
    btrfs filesystem resize "$BTRFS_DEVID:$BTRFS_TARGET" /
    local now
    now=$(btrfs filesystem usage -b / | awk '/Device size:/ {print $3}')
    ((now <= BTRFS_TARGET)) || die "Btrfs fait encore $now octets (> $BTRFS_TARGET) : arrêt avant de toucher LUKS"

    if ((LUKS)); then
      phase 60 70 "Réduction du conteneur LUKS « $DM_NAME » à $NEW_INNER secteurs"
      luks_resize --size "$NEW_INNER" "$DM_NAME"
      now=$(blockdev --getsz "/dev/mapper/$DM_NAME")
      ((now == NEW_INNER)) || die "LUKS fait $now secteurs au lieu de $NEW_INNER : arrêt avant de toucher la partition"
      ((now * 512 >= BTRFS_TARGET)) || die "incohérence LUKS/Btrfs, arrêt"
    fi

    phase 70 75 "Réduction de la partition n°$PART_NUM à $NEW_SIZE secteurs"
    # --wipe*/never : ne jamais toucher aux signatures (en-tête LUKS, superbloc Btrfs)
    echo "$START, $NEW_SIZE" | sfdisk --no-reread --no-tell-kernel --wipe never --wipe-partitions never -N "$PART_NUM" "/dev/$DISK"
  fi

  phase 75 80 "Création des partitions MSR, Windows et $STAGE_LABEL"
  sfdisk --no-reread --no-tell-kernel --wipe never --append "/dev/$DISK" <<EOF
start=$MSR_START, size=$((MSR_MIB * MIB)), type=$TYPE_MSR, name="Microsoft reserved partition"
start=$WIN_START, size=$((WIN_MIB * MIB)), type=$TYPE_BASIC, name="Windows"
start=$STAGE_START, size=$((STAGE_MIB * MIB)), type=$TYPE_BASIC, name="$STAGE_LABEL"
EOF
  local num start
  MSR_NUM="" WIN_NUM="" STAGE_NUM=""
  # numéros attribués par sfdisk, retrouvés par leur début
  while read -r num start _; do
    case $start in
    "$MSR_START") MSR_NUM=$num ;;
    "$WIN_START") WIN_NUM=$num ;;
    "$STAGE_START") STAGE_NUM=$num ;;
    esac
  done < <(part_table "$DISK")
  STAGED=0 UNATTENDED=0 VMD_DRIVER=0 NET_DRIVERS=0 STAGE_PARTUUID=
  LINUX_BOOT=$(boot_current)
  [[ $MSR_NUM =~ ^[0-9]+$ && $WIN_NUM =~ ^[0-9]+$ && $STAGE_NUM =~ ^[0-9]+$ ]] || die "numéros des nouvelles partitions illisibles"
  save_state

  phase 80 85 "Mise à jour de la table du noyau"
  local live=1
  if [[ $MODE == shrink ]]; then
    partx -u --nr "$PART_NUM" "/dev/$DISK" || live=0
  fi
  for num in "$MSR_NUM" "$WIN_NUM" "$STAGE_NUM"; do
    partx -a --nr "$num" "/dev/$DISK" 2>/dev/null || partx -u --nr "$num" "/dev/$DISK" || live=0
  done
  udevadm settle 2>/dev/null || true
  [[ $MODE == shrink ]] && { (($(<"/sys/class/block/$PART/size") == NEW_SIZE)) || live=0; }
  partdev "$DISK" "$STAGE_NUM" >/dev/null || live=0

  if ((live)); then
    if [[ $MODE == shrink ]]; then
      phase 85 100 "Agrandissement de LUKS et Btrfs dans la marge restante"
      ((LUKS)) && luks_resize "$DM_NAME"
      btrfs filesystem resize "$BTRFS_DEVID:max" /
    fi
    progress 100
    echo
    echo "OK. Étape suivante : $(basename "$SELF") stage --iso <fichier.iso>"
  else
    echo
    echo "Le noyau n'a pas pu relire la table de partitions à chaud (sans danger$([[ $MODE == shrink ]] && echo " :
Btrfs et LUKS sont déjà plus petits que la nouvelle partition")."
    echo "Redémarre Linux, puis lance : $(basename "$SELF") stage --iso <fichier.iso>"
  fi
}

