# Copyright (C) 2026 2Deathadder — https://github.com/2Deathadder/linwin
# linwin v1 — installe Windows 10 en dual-boot natif depuis Linux, sans clé USB.
#
# Principe : on trouve de la place sur le disque de la partition EFI — de l'espace
# non alloué (n'importe quelle distribution, n'importe quel système de fichiers),
# sinon en réduisant à chaud une racine Btrfs (éventuellement dans LUKS) — et on y
# crée une MSR, une partition cible Windows et une petite partition FAT32
# « WINSETUP » qui joue le rôle de clé USB. On y copie l'ISO, puis une entrée UEFI
# à usage unique (BootNext) démarre l'installeur Windows.
#
# Exigences : PC x86-64 en UEFI 64 bits, disque GPT à secteurs de 512 octets.
# Distributions : pacman, apt, dnf, zypper, xbps, apk ou emerge pour les outils
# manquants ; finalisation automatique avec systemd ou OpenRC. Chargeurs
# reconnus : GRUB, systemd-boot, Limine, rEFInd (sinon : menu de démarrage UEFI).
#
# Étapes :  check → plan → iso → prepare → stage → boot → (installer Windows) → finish
set -euo pipefail

VERSION=1
STATE_DIR=/var/lib/linwin
STATE=$STATE_DIR/state
MIB=2048                 # secteurs de 512 octets par Mio
MSR_MIB=16
MARGIN_MIB=1024          # Btrfs est réduit 1 Gio de plus que nécessaire, puis regrossi
HEADROOM_GIB=20          # espace Btrfs non alloué qui doit rester après réduction
ALIGN_SECTORS=2048       # partitions alignées sur 1 Mio
TYPE_ESP=C12A7328-F81F-11D2-BA4B-00A0C93EC93B
STAGE_DEFAULT=8G
TYPE_MSR=E3C9E316-0B5C-4DB8-817D-F92DF00215AE
TYPE_BASIC=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7
STAGE_LABEL=WINSETUP
TAG=linwin.tag         # repère de WINSETUP pour start.cmd (journal)
EFI_LABEL="Windows 10 Setup (linwin)"
WIN10_PAGE=https://www.microsoft.com/fr-fr/software-download/windows10ISO
UA="Mozilla/5.0 (X11; Linux x86_64; rv:140.0) Gecko/20100101 Firefox/140.0"

# Copie de confiance (root:root, non modifiable par l'utilisateur), installée par
# « install ». L'interface graphique ne lance que celle-ci en root.
INSTALL_DIR=/usr/local/lib/linwin
INSTALLED_BIN=$INSTALL_DIR/linwin
AUTO_UNIT=/etc/systemd/system/linwin-finish.service
AUTO_OPENRC=/etc/local.d/linwin-finish.start   # équivalent pour OpenRC (service « local »)
GRUB_SCRIPT=/etc/grub.d/35_linwin_windows       # entrée Windows pour GRUB (chainloader)
DRV_CACHE=$STATE_DIR/drivers                    # pilotes du catalogue Microsoft Update
LOCK=/run/linwin.lock
RUN_LOG=/run/linwin.log   # sortie de l'opération en cours (mode --progress)
LEGACY=win-dualboot          # ancien nom du projet (avant la v1) : repris par « install »
LEGACY_EFI_LABEL="Windows 10 Setup ($LEGACY)"

SELF=$(readlink -f "$0")

# --- utilitaires ---------------------------------------------------------------

die() { echo "ERREUR : $*" >&2; exit 1; }
warn() { echo "ATTENTION : $*" >&2; }
step() { echo; echo "==> $*"; }

# --- progression (pour l'interface : « linwin --progress <commande> ») ------
# Chaque phase couvre une plage du pourcentage global ; l'interface lit les lignes
# « @@progress POURCENT LIBELLÉ ». Sans --progress, rien n'est émis.
PROGRESS=0 PHASE_A=0 PHASE_B=0 PHASE_LABEL=""

# phase DÉBUT FIN LIBELLÉ : nouvelle phase (affichée aussi comme étape « ==> »)
phase() {
  PHASE_A=$1 PHASE_B=$2 PHASE_LABEL=$3
  step "$3"
  progress 0
}

# progress N : avancement N % de la phase en cours
progress() {
  ((PROGRESS)) || return 0
  local n=$1
  ((n > 100)) && n=100
  ((n < 0)) && n=0
  echo "@@progress $((PHASE_A + n * (PHASE_B - PHASE_A) / 100)) $PHASE_LABEL"
}

# Filtre la sortie de wimlib/curl : « … (42%) » devient une ligne @@progress,
# le reste passe tel quel. awk lit tout jusqu'au bout (pas de Broken pipe).
progress_filter() {
  if ((!PROGRESS)); then
    cat
    return
  fi
  awk -v RS='[\r\n]' -v a="$PHASE_A" -v b="$PHASE_B" -v l="$PHASE_LABEL" '
    match($0, /\(?[0-9]+(\.[0-9]+)?%\)?/) {
      v = substr($0, RSTART, RLENGTH); gsub(/[()%]/, "", v)
      p = int(a + v * (b - a) / 100)
      if (p != last) { print "@@progress " p " " l; fflush(); last = p }
      next
    }
    /^[#=O -]+$/ { next }
    length($0) { print; fflush() }'
}

# progress_size TOTAL_OCTETS POINT_DE_MONTAGE COMMANDE… : lance la commande en
# suivant l'espace occupé sur le point de montage (copie vers WINSETUP).
progress_size() {
  local total=$1 mnt=$2 base used pid
  shift 2
  base=$(df -B1 --output=used "$mnt" | sed -n 2p)
  "$@" &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    used=$(df -B1 --output=used "$mnt" | sed -n 2p)
    ((total > 0)) && progress $(((used - base) * 100 / total))
    sleep 1
  done
  wait "$pid"
  progress 100
}

# Repasse en root si besoin, puis prend le verrou : deux opérations en même temps
# (interface + terminal) sur la table de partitions seraient catastrophiques.
as_root() {
  if ((EUID != 0)); then
    ((PROGRESS)) && exec sudo -- "$SELF" --progress "$@"
    exec sudo -- "$SELF" "$@"
  fi
  exec 9>"$LOCK"
  flock -n 9 || die "une autre opération linwin est déjà en cours"
  if ((PROGRESS)); then
    # Toute la sortie passe aussi par $RUN_LOG : si l'interface se ferme, tee -p
    # continue d'écrire le fichier au lieu de mourir, aucun outil ne reçoit de
    # « Broken pipe », et une interface rouverte reprend l'affichage depuis ce fichier.
    : >"$RUN_LOG"
    chmod 644 "$RUN_LOG"
    exec > >(tee -p -a "$RUN_LOG") 2>&1
    echo "@@run $1"
  fi
}

# Vrai si une opération tient le verrou (lu dans /proc/locks : sans prendre le
# verrou, donc sans risque de gêner l'opération qui démarre)
op_running() {
  [[ -e $LOCK ]] && grep -q "FLOCK .*:$(stat -c %i "$LOCK") " /proc/locks
}

# Sur un portable, une coupure pendant le redimensionnement peut détruire Linux.
require_ac() {
  local s has_battery=0
  for s in /sys/class/power_supply/*; do
    [[ -f $s/type ]] || continue
    case $(<"$s/type") in
    Mains) [[ $(<"$s/online") == 1 ]] && return 0 ;;
    Battery) has_battery=1 ;;
    esac
  done
  ((!has_battery)) || die "l'ordinateur est sur batterie : branche le chargeur avant de continuer"
}

oem_license() { [[ -e /sys/firmware/acpi/tables/MSDM ]]; }

# --- plateforme (distribution, firmware, chargeur) --------------------------------

# Famille du gestionnaire de paquets : arch, deb, rpm, suse, void, alpine, gentoo
pkg_family() {
  local f
  for f in pacman:arch apt-get:deb dnf:rpm yum:rpm zypper:suse xbps-install:void apk:alpine emerge:gentoo; do
    command -v "${f%%:*}" >/dev/null && { echo "${f#*:}"; return 0; }
  done
  return 1
}

# Paquet(s) candidat(s) qui fournissent une commande, selon la famille
pkg_names() {
  case $1:$2 in
  wimlib-imagex:deb) echo wimtools ;;
  wimlib-imagex:rpm) echo wimlib-utils wimlib ;;
  wimlib-imagex:suse) echo wimtools wimlib ;;
  wimlib-imagex:gentoo) echo app-arch/wimlib ;;
  wimlib-imagex:*) echo wimlib ;;
  mkfs.fat:gentoo) echo sys-fs/dosfstools ;;
  mkfs.fat:*) echo dosfstools ;;
  sfdisk:deb) echo fdisk util-linux ;;
  sfdisk:gentoo | partx:gentoo | wipefs:gentoo) echo sys-apps/util-linux ;;
  sfdisk:* | partx:* | wipefs:*) echo util-linux ;;
  cabextract:gentoo) echo app-arch/cabextract ;;
  efibootmgr:gentoo) echo sys-boot/efibootmgr ;;
  curl:gentoo) echo net-misc/curl ;;
  python3:arch) echo python ;;
  python3:gentoo) echo dev-lang/python ;;
  *) echo "$1" ;;
  esac
}

# Installe une commande manquante avec le gestionnaire de paquets (root)
ensure_tool() {
  local cmd=$1 fam pkg
  command -v "$cmd" >/dev/null && return 0
  [[ -e /run/ostree-booted ]] &&
    die "« $cmd » manque et ce système est immuable (ostree) : installe-le (rpm-ostree install $(pkg_names "$cmd" rpm | cut -d' ' -f1)), redémarre, puis relance"
  fam=$(pkg_family) || die "« $cmd » manque et aucun gestionnaire de paquets connu n'est présent : installe-le à la main"
  for pkg in $(pkg_names "$cmd" "$fam"); do
    echo "Installation du paquet $pkg (pour $cmd)…"
    case $fam in
    arch) pacman -S --needed --noconfirm "$pkg" ;;
    deb) DEBIAN_FRONTEND=noninteractive apt-get install -y "$pkg" ||
      { apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y "$pkg"; } ;;
    rpm) if command -v dnf >/dev/null; then dnf install -y "$pkg"; else yum install -y "$pkg"; fi ;;
    suse) zypper --non-interactive install "$pkg" ;;
    void) xbps-install -Sy "$pkg" ;;
    alpine) apk add "$pkg" ;;
    gentoo) emerge --noreplace "$pkg" ;;
    esac >&2 || true
    hash -r
    command -v "$cmd" >/dev/null && return 0
  done
  die "impossible d'installer « $cmd » (paquet $(pkg_names "$cmd" "$fam" | sed 's/ / ou /g')) : installe-le à la main puis relance"
}

# Affiche la raison pour laquelle ce PC ne convient pas (code 1 : il convient)
platform_problem() {
  [[ $(uname -m) == x86_64 ]] || { echo "processeur $(uname -m) : il faut un PC x86-64 pour Windows 10 x64"; return 0; }
  [[ -d /sys/firmware/efi ]] || { echo "Linux a démarré en mode BIOS (Legacy/CSM) : linwin exige un démarrage UEFI"; return 0; }
  [[ $(cat /sys/firmware/efi/fw_platform_size 2>/dev/null || echo 64) == 64 ]] ||
    { echo "firmware UEFI 32 bits : l'installeur Windows x64 ne peut pas y démarrer"; return 0; }
  return 1
}

# Partition EFI montée : ESP_DIR, ESP_DEV, ESP_DISK (code 1 si introuvable)
find_esp() {
  local mp dev type
  ESP_DIR="" ESP_DEV="" ESP_DISK=""
  # /efi et /boot/efi sont parfois des montages automatiques : un accès les déclenche
  ls /efi /boot/efi /boot >/dev/null 2>&1 || true
  for mp in /boot/efi /efi /boot $(findmnt -rno TARGET -t vfat 2>/dev/null); do
    [[ $(findmnt -no FSTYPE -M "$mp" 2>/dev/null) == vfat ]] || continue
    dev=$(readlink -f "$(findmnt -no SOURCE -M "$mp")")
    type=$(lsblk -dno PARTTYPE "$dev" 2>/dev/null | tr a-f A-F)
    [[ $type == "$TYPE_ESP" || -d $mp/EFI ]] || continue
    [[ -f /sys/class/block/${dev##*/}/partition ]] || continue
    ESP_DIR=$mp ESP_DEV=$dev
    ESP_DISK=$(basename "$(readlink -f "/sys/class/block/${dev##*/}/..")")
    return 0
  done
  return 1
}

init_kind() {
  if [[ -d /run/systemd/system ]]; then
    echo systemd
  elif [[ -d /run/openrc ]] || command -v openrc >/dev/null; then
    echo openrc
  else
    echo autre
  fi
}

distro_name() { (. /etc/os-release 2>/dev/null && echo "${PRETTY_NAME:-${NAME:-Linux}}") || echo Linux; }

# Entrée UEFI qui a démarré Linux (numéro hexadécimal, ex. 0003)
boot_current() { efibootmgr 2>/dev/null | awk -F': ' '/^BootCurrent/ {print $2}'; }

# Chargeur qui a démarré Linux : limine, systemd-boot, grub, refind ou inconnu.
# D'après le chemin de l'entrée UEFI BootCurrent, sinon d'après ce qui est installé.
boot_loader_kind() {
  local cur line
  cur=$(boot_current)
  line=$( [[ -n $cur ]] && efibootmgr -v 2>/dev/null | grep -i "^Boot$cur" | tr 'A-Z' 'a-z' || true)
  case $line in
  *limine*) echo limine; return ;;
  *systemd-boot* | *"linux boot manager"*) echo systemd-boot; return ;;
  *grub* | *shim*) echo grub; return ;;
  *refind*) echo refind; return ;;
  esac
  [[ -z ${ESP_DIR:-} ]] && find_esp || true
  if [[ -n ${ESP_DIR:-} && -f $ESP_DIR/limine.conf ]] || command -v limine-update >/dev/null; then
    echo limine
  elif [[ -n ${ESP_DIR:-} && -f $ESP_DIR/loader/loader.conf ]]; then
    echo systemd-boot
  elif command -v grub-mkconfig >/dev/null || command -v grub2-mkconfig >/dev/null; then
    echo grub
  elif [[ -n ${ESP_DIR:-} && -d $ESP_DIR/EFI/refind ]]; then
    echo refind
  else
    echo inconnu
  fi
}

loader_label() {
  case $1 in
  limine) echo Limine ;; systemd-boot) echo systemd-boot ;; grub) echo GRUB ;; refind) echo rEFInd ;;
  *) echo "le menu de démarrage UEFI" ;;
  esac
}

# Vrai si la copie installée est sûre à lancer en root : root:root, ni elle ni
# ses dossiers parents ne sont modifiables par un autre utilisateur.
installed_trusted() {
  local p=$INSTALLED_BIN
  [[ -f $p && ! -L $p ]] || return 1
  while :; do
    [[ $(stat -Lc '%u' "$p") == 0 ]] && ! (($(stat -Lc '0%a' "$p") & 022)) || return 1
    [[ $p == / ]] && return 0
    p=$(dirname "$p")
  done
}

# "100G" / "512M" -> Mio
to_mib() {
  [[ $1 =~ ^([0-9]+)([GgMm])$ ]] || die "taille invalide : $1 (ex. 100G)"
  local n=${BASH_REMATCH[1]}
  [[ ${BASH_REMATCH[2]} == [Gg] ]] && echo $((n * 1024)) || echo "$n"
}

gib() { awk -v s="$1" 'BEGIN { printf "%.1f Gio", s * 512 / 1073741824 }'; }

# Chemin /dev d'une partition à partir du disque et du numéro (nvme0n1p3, sda3…)
partdev() {
  local d
  for d in /sys/class/block/"$1"*; do
    [[ -f $d/partition && $(<"$d/partition") == "$2" ]] && { echo "/dev/${d##*/}"; return; }
  done
  return 1
}

vmd_active() { compgen -G '/sys/bus/pci/drivers/vmd/[0-9a-f]*:*' >/dev/null; }

# Pilote Intel RST VMD « F6 » (iaStorVD 20.2.6.1025 : contrôleurs VMD 467F, A77F,
# 7D0B et AD0B, soit 12e à 14e gén. et Core Ultra ; PAS la 11e gén., 9A0B).
# Intel ne publie plus le zip F6 : on prend l'installeur officiel et on en
# extrait le zip .NET embarqué. Toutes les empreintes sont épinglées.
RST_URL=https://downloadmirror.intel.com/865363/SetupRST.exe
RST_SHA256=7fe68cd6e00dbde798ed895c649f5a3a31738877274dfba54dbef15546ee3dd2
RST_CACHE=$STATE_DIR/vmd-driver
RST_FILES=(
  "24696802a8c8e198d572eaa721c81fa0c29e6336a1ab200bf553aa613c3681a5  iaStorVD.cat"
  "ed5fd2234947ff6d67ef8efccae6b4be1f0aa5b65188ce40d98f927d5c0c80d0  iaStorVD.inf"
  "7d2f5e62f6717e9df8925e29b4b8789316505cb2d8b6ea0d22104249f692b7c8  iaStorVD.sys"
  # exigés par l'INF (CopyFiles) : sans eux, drvload et « Charger un pilote » échouent
  "94e37b495ea2866240dcf2b8cbb949d9703c28b9b54c2027e6fbb0e30b9533e3  RstMwService.exe"
  "27f9ae9d9c7596258b7f54d877b6f5fce7dbaf5ce9e2c03c998a029bef2417e4  RstMwEventLogMsg.dll"
)

# Identifiants PCI des contrôleurs VMD actifs (ex. A77F)
vmd_ids() {
  local d
  for d in /sys/bus/pci/drivers/vmd/[0-9a-f]*:*; do
    [[ -f $d/device ]] || continue
    sed 's/^0x//' <"$d/device" | tr a-f A-F
  done
}

# Vrai si un .inf du dossier gère tous les contrôleurs VMD actifs (INF en UTF-16 ou ANSI)
driver_supports() {
  local id text
  # retirer les octets nuls ramène l'UTF-16 des identifiants PCI à de l'ASCII
  text=$(find "$1" -iname '*.inf' -exec cat {} + | tr -d '\0')
  for id in $(vmd_ids); do
    grep -qi "VEN_8086&DEV_$id" <<<"$text" || return 1
  done
}

# Empêche le bureau (udisks) de monter WINSETUP et démonte ce qui l'est déjà :
# mkfs.fat refuse une partition montée. Règle dans /run : disparaît au redémarrage.
release_stage_dev() {
  local t
  mkdir -p /run/udev/rules.d
  printf '%s\n' "ENV{ID_FS_LABEL}==\"$STAGE_LABEL\", ENV{UDISKS_IGNORE}=\"1\", ENV{UDISKS_AUTO}=\"0\"" \
    "KERNEL==\"${1##*/}\", ENV{UDISKS_IGNORE}=\"1\", ENV{UDISKS_AUTO}=\"0\"" >/run/udev/rules.d/90-linwin.rules
  udevadm control --reload || true
  udevadm trigger --settle "$1" 2>/dev/null || true
  while t=$(findmnt -rno TARGET -S "$1" | sed -n 1p) && [[ -n $t ]]; do
    umount "$t" || die "impossible de démonter $1 ($t) : ferme les fenêtres qui l'utilisent"
  done
}

rst_cached() { [[ -d $RST_CACHE ]] && (cd "$RST_CACHE" && printf '%s\n' "${RST_FILES[@]}" | sha256sum -c --quiet) >/dev/null 2>&1; }

# Télécharge et extrait le pilote dans $RST_CACHE (si absent ou altéré)
fetch_rst_driver() {
  rst_cached && return
  local tmp
  tmp=$(mktemp -d)
  curl -fL --retry 3 --progress-bar -A "$UA" -o "$tmp/SetupRST.exe" "$RST_URL" 2>&1 | progress_filter ||
    { rm -rf "$tmp"; die "téléchargement impossible : $RST_URL"; }
  echo "$RST_SHA256  $tmp/SetupRST.exe" | sha256sum -c --quiet || { rm -rf "$tmp"; die "SetupRST.exe n'a pas l'empreinte attendue"; }
  python3 - "$tmp/SetupRST.exe" "$tmp/out" <<'EOF' || { rm -rf "$tmp"; die "pilote introuvable dans SetupRST.exe"; }
import io, os, sys, zipfile
data, out = open(sys.argv[1], "rb").read(), sys.argv[2]
end = 0
while (end := data.find(b"PK\x05\x06", end + 1)) > 0:
    size, off = int.from_bytes(data[end + 12:end + 16], "little"), int.from_bytes(data[end + 16:end + 20], "little")
    try:
        z = zipfile.ZipFile(io.BytesIO(data[end - size - off:end + 22]))
    except zipfile.BadZipFile:
        continue
    if "iaStorVD.inf" in z.namelist():
        os.makedirs(out)
        z.extractall(out)  # tout le paquet F6 : l'INF copie aussi RstMwService.exe et sa DLL
        sys.exit(0)
sys.exit(1)
EOF
  (cd "$tmp/out" && printf '%s\n' "${RST_FILES[@]}" | sha256sum -c --quiet) || { rm -rf "$tmp"; die "fichiers du pilote altérés"; }
  rm -rf "$RST_CACHE"
  mkdir -p "$STATE_DIR"
  mv "$tmp/out" "$RST_CACHE"
  rm -rf "$tmp"
  echo "Pilote prêt : $RST_CACHE (signé WHQL par Microsoft)"
}

# Contrôleurs VMD gérés par le pilote RST épinglé ci-dessus
RST_VMD_IDS="467F A77F 7D0B AD0B"
rst_covers() {
  local id
  for id in $(vmd_ids); do
    [[ " $RST_VMD_IDS " == *" $id "* ]] || return 1
  done
}

# --- pilotes du catalogue Microsoft Update ------------------------------------------
# Windows 10 n'a pas de pilote d'origine pour beaucoup de cartes récentes (Wi-Fi
# Intel AX2xx/BE2xx, MediaTek MT79xx, Realtek RTL8852/8922, Ethernet 2,5 Gbit/s…) :
# sans réseau, pas de Windows Update. Le catalogue Microsoft Update publie, par
# identifiant matériel, les pilotes signés WHQL que Windows Update distribue. On
# choisit le plus récent qui déclare ce périphérique pour Windows 10 x64 (build
# 19045), on vérifie le SHA-1 annoncé par Microsoft, puis Windows contrôle à son
# tour la signature du pilote à l'installation.

# Identifiant matériel PCI au format Windows : VEN_8086&DEV_51F1&SUBSYS_00948086&REV_1A
pci_hwid() {
  local d=$1
  printf 'VEN_%s&DEV_%s&SUBSYS_%s%s&REV_%s\n' "$(sed 's/^0x//' <"$d/vendor")" "$(sed 's/^0x//' <"$d/device")" \
    "$(sed 's/^0x//' <"$d/subsystem_device")" "$(sed 's/^0x//' <"$d/subsystem_vendor")" \
    "$(sed 's/^0x//' <"$d/revision")" | tr a-f A-F
}

pci_name() {
  local d=$1 name=""
  command -v lspci >/dev/null && name=$(lspci -s "${d##*/}" 2>/dev/null | sed 's/^[^ ]* [^:]*: //; s/ (rev [0-9a-f]*)$//')
  if [[ -z $name ]]; then
    case $(<"$d/class") in
    0x0280*) name="carte Wi-Fi" ;;
    0x0200*) name="carte Ethernet" ;;
    *) name="carte réseau" ;;
    esac
  fi
  echo "$name"
}

# Cartes réseau PCI (Ethernet, Wi-Fi) : une ligne « HWID|nom » par carte
net_devices() {
  local d
  for d in /sys/bus/pci/devices/*; do
    [[ -f $d/class && $(<"$d/class") == 0x02* ]] || continue
    printf '%s|%s\n' "$(pci_hwid "$d")" "$(pci_name "$d")"
  done
}

# Dossier de cache d'un pilote : $DRV_CACHE/VEN_8086&DEV_51F1&SUBSYS_00948086
drv_dir() { echo "$DRV_CACHE/${1%&REV_*}"; }
drv_cached() { [[ -f $(drv_dir "$1")/linwin-source.txt ]]; }

# catalog_fetch HWID CLASSE : télécharge dans drv_dir le pilote du catalogue (si absent)
catalog_fetch() {
  local hwid=$1 cls=${2:-} dir
  dir=$(drv_dir "$hwid")
  drv_cached "$hwid" && { echo "Déjà téléchargé : $(sed -n 1p "$dir/linwin-source.txt")"; return 0; }
  ensure_tool cabextract
  mkdir -p "$DRV_CACHE"
  rm -rf "$dir"
  python3 - "$dir" "PCI\\$hwid" "$cls" "$UA" <<'PY'
import base64, hashlib, html, json, os, re, shutil, subprocess, sys, tempfile
import urllib.parse, urllib.request

out, hwid, cls, ua = sys.argv[1:5]
CAT = "https://www.catalog.update.microsoft.com/"
WIN10_BUILD = 19045

m = re.match(r"PCI\\VEN_(\w{4})&DEV_(\w{4})(?:&SUBSYS_(\w{8}))?(?:&REV_(\w{2}))?$", hwid, re.I)
if not m:
    sys.exit(f"identifiant matériel illisible : {hwid}")
ven, dev, sub, rev = (g.upper() if g else None for g in m.groups())
base = f"PCI\\VEN_{ven}&DEV_{dev}"
# les identifiants que Windows génère pour ce périphérique, du plus précis au plus vague
ids = []
if sub:
    ids += [f"{base}&SUBSYS_{sub}&REV_{rev}", f"{base}&SUBSYS_{sub}"]
if rev:
    ids.append(f"{base}&REV_{rev}")
if cls:
    ids += [f"{base}&CC_{cls}", f"{base}&CC_{cls[:4]}"]
ids.append(base)
wanted = {i.upper() for i in ids}


def get(url, data=None):
    req = urllib.request.Request(url, data=data, headers={"User-Agent": ua})
    with urllib.request.urlopen(req, timeout=90) as r:
        return r.read()


def search(q):
    t = get(CAT + "Search.aspx?q=" + urllib.parse.quote(q)).decode("utf-8", "replace")
    rows = []
    for m in re.finditer(r'<tr id="([0-9a-f-]{36})_R\d+"(.*?)</tr>', t, re.S):
        cells = [html.unescape(re.sub(r"<[^>]+>", "", c)).strip()
                 for c in re.findall(r"<td[^>]*>(.*?)</td>", m.group(2), re.S)]
        if len(cells) >= 6:
            rows.append({"id": m.group(1), "title": cells[1], "products": cells[2], "version": cells[5]})
    return rows


def version_key(r):
    # colonne « Version », sinon la version écrite dans le titre (« … 10.71.312.2024 »)
    for text in (r["version"], r["title"]):
        m = re.search(r"\d+(?:\.\d+){1,3}", text)
        if m:
            return tuple(int(x) for x in m.group(0).split("."))
    return ()


def decoded(path):
    b = open(path, "rb").read()
    if b[:2] == b"\xff\xfe" or (len(b) > 1 and b[1] == 0):
        return b.decode("utf-16-le", "ignore").lstrip("﻿")
    return b.decode("latin-1")


def sections(text):
    sec, cur = {}, None
    for line in text.splitlines():
        line = line.split(";", 1)[0].strip()
        if not line:
            continue
        h = re.match(r"^\[(.+)\]$", line)
        if h:
            cur = sec.setdefault(h.group(1).strip().lower(), [])
        elif cur is not None:
            cur.append(line)
    return sec


def deco_ok(deco):
    # NTamd64[.Major[.Minor[.ProductType[.SuiteMask[.BuildNumber]]]]]
    p = deco.strip().lower().split(".")
    if p[0] != "ntamd64":
        return False
    try:
        if len(p) > 2 and p[1] and (int(p[1]), int(p[2] or 0)) > (10, 0):
            return False
        if len(p) > 5 and p[5] and int(p[5]) > WIN10_BUILD:
            return False
    except ValueError:
        return False
    return True


def inf_supports(path):
    sec = sections(decoded(path))
    for line in sec.get("manufacturer", []):
        if "=" not in line:
            continue
        parts = [x.strip() for x in line.split("=", 1)[1].split(",")]
        for deco in parts[1:]:
            if not deco_ok(deco):
                continue
            for entry in sec.get(f"{parts[0]}.{deco}".lower(), []):
                if "=" in entry and any(h.strip().upper() in wanted for h in entry.split("=", 1)[1].split(",")[1:]):
                    return True
    return False


def files_of(uid):
    data = urllib.parse.urlencode({"updateIDs": json.dumps(
        [{"size": 0, "languages": "", "uidInfo": uid, "updateID": uid}])}).encode()
    t = get(CAT + "DownloadDialog.aspx", data).decode("utf-8", "replace")
    digests = dict(re.findall(r"files\[(\d+)\]\.digest = '([^']*)'", t))
    return [(u, digests.get(i)) for i, u in re.findall(r"files\[(\d+)\]\.url = '([^']*)'", t)]


# Une page de résultats ne compte que 25 lignes : on filtre la recherche sur
# « Windows 10 », et les pilotes propres à ce modèle (SUBSYS) passent en premier.
rows, seen = [], set()
queries = ([f"{base}&SUBSYS_{sub} Windows 10"] if sub else []) + [f"{base} Windows 10", base]
for q in queries:
    try:
        found = search(q)
    except Exception as e:
        print(f"catalogue injoignable : {e}", file=sys.stderr)
        sys.exit(2)
    batch = [r for r in found if r["id"] not in seen and re.search(r"Windows 10(?! S)", r["products"])]
    batch.sort(key=version_key, reverse=True)
    for r in batch:
        seen.add(r["id"])
        rows.append(r)

tmp = tempfile.mkdtemp()
try:
    for r in rows[:6]:
        for url, digest in files_of(r["id"]):
            u = urllib.parse.urlparse(url)
            host = u.hostname or ""
            if not (host.endswith(".windowsupdate.com") or host.endswith(".microsoft.com")) or not digest:
                continue
            if not u.path.lower().endswith(".cab"):
                continue
            cab = os.path.join(tmp, "driver.cab")
            data = get(urllib.parse.urlunparse(u._replace(scheme="https")))
            if base64.b64encode(hashlib.sha1(data).digest()).decode() != digest:
                print(f"empreinte SHA-1 incorrecte pour {url} : ignoré", file=sys.stderr)
                continue
            open(cab, "wb").write(data)
            ext = os.path.join(tmp, "x")
            shutil.rmtree(ext, ignore_errors=True)
            os.makedirs(ext)
            if subprocess.run(["cabextract", "-q", "-d", ext, cab], capture_output=True).returncode:
                continue
            infs = [os.path.join(d, f) for d, _, fs in os.walk(ext) for f in fs if f.lower().endswith(".inf")]
            if any(inf_supports(i) for i in infs):
                shutil.move(ext, out)
                with open(os.path.join(out, "linwin-source.txt"), "w") as f:
                    f.write(f"{r['title']} — version {r['version']}\n{url}\nSHA-1 {digest}\n")
                print(f"{r['title']} — version {r['version']}")
                sys.exit(0)
finally:
    shutil.rmtree(tmp, ignore_errors=True)
print(f"aucun pilote Windows 10 x64 pour {hwid} dans le catalogue Microsoft Update", file=sys.stderr)
sys.exit(1)
PY
}

# Télécharge les pilotes des cartes réseau. Affiche les dossiers obtenus.
# Jamais fatal : sans pilote, Windows garde ses pilotes d'origine (souvent
# suffisants pour l'Ethernet) et Windows Update fera le reste une fois connecté.
fetch_net_drivers() {
  local d id name cls
  for d in /sys/bus/pci/devices/*; do
    [[ -f $d/class && $(<"$d/class") == 0x02* ]] || continue
    id=$(pci_hwid "$d") name=$(pci_name "$d") cls=$(sed 's/^0x//' <"$d/class" | tr a-f A-F)
    echo "Pilote pour $name ($id) :" >&2
    if catalog_fetch "$id" "$cls" >&2; then
      drv_dir "$id"
    else
      warn "pas de pilote du catalogue pour $name : Windows utilisera son pilote d'origine s'il en a un"
    fi
  done
}


